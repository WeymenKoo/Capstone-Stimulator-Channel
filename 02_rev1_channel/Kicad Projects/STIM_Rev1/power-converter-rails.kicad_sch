	(text_box "LAYOUT NOTE L1:\n• U2, U3, U4, U5: thermal pad (pin 9) to ISO_GND with vias\n• CIN, COUT and the NR/SS cap beside their pins; the four LDOs use the U2 pattern, clustered next to U1\n• 0.65 mm pitch: 0.15 mm pad gaps (rule \"fine-pitch LDO pads\"), mask bridges allowed"
		(exclude_from_sim no)
		(at 179.07 190.5 0)
		(size 62 17.145)
		(margins 1 1 1 1)
		(stroke
			(width 1)
