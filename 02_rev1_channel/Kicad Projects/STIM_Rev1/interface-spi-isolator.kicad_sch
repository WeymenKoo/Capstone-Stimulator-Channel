	(text_box "LAYOUT NOTE L1:\n• Barrier under the isolators and U1: no copper across the gap (DW body 8 mm creepage)\n• GND pour on the FPGA side only"
		(exclude_from_sim no)
		(at 81.28 167.64 0)
		(size 52.07 13.97)
		(margins 1 1 1 1)
		(stroke
			(width 1)
			(type solid)
			(color 0 0 255 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 255 1)
			)
			(justify left top)
		)
		(uuid "132ba020-1927-4c92-a506-ed55b981578e")
	)
	(text_box "DESIGN NOTE D1:\n• U6 ISO7741F (default LOW): EN_CH1, MOSI, SCLK; FAULT_N back\n• U7 ISO7741 (default HIGH): CS_ADC, LDAC, CS_DAC; MISO back\n• U19 ISO7740F (default LOW): EN_CH2-4, CLR\n• Side 1 from +3V3_FPGA, side 2 from +3V3; 100 nF at every VCC pin"
		(exclude_from_sim no)
		(at 27.94 132.08 0)
		(size 52.07 22.86)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "259bebb9-cf88-423c-abf2-d8fed84eef91")
	)
	(text_box "LAYOUT NOTE L2:\n• J4 / J7 beside the isolators; never plug J3 and J4 with JP1 open"
		(exclude_from_sim no)
		(at 81.28 182.88 0)
		(size 52.07 11.43)
		(margins 1 1 1 1)
		(stroke
			(width 1)
			(type solid)
			(color 0 0 255 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 255 1)
			)
			(justify left top)
		)
		(uuid "3f744a89-801c-4449-911c-ddc30fca5038")
	)
	(text_box "DESIGN NOTE D4:\n• J3 = Red Pitaya E1, pin for pin: 5 MISO, 7 CS_DAC, 9 LDAC, 10 CLR, 11 CS_ADC, 12 FAULT_N, 13 SCLK, 14 EN_CH4, 15 MOSI, 16 EN_CH2, 17 EN_CH1, 18 EN_CH3\n• Free: 3 / 4 (trigger), 6, 8. Contract: ICD_J3.md"
		(exclude_from_sim no)
		(at 27.94 189.23 0)
		(size 52.07 16.51)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "55a91470-fe21-4018-93b2-cfda61321182")
	)
	(text_box "MISC NOTE M2:\n• FPGA: DAC at 0 for 3 ms after EN (D-08), cleared when EN drops\n• CS_DAC and CS_ADC never both low; one LDAC pulse updates all DAC outputs"
		(exclude_from_sim no)
		(at 81.28 149.86 0)
		(size 52.07 16.51)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 255 165 0 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "73b3cae1-a5ab-4a95-8da3-ef78e1c3238b")
	)
	(text_box "DESIGN NOTE D3:\n• FAULT_N: R12 pull-up, not driven in Rev 1 (the FPGA reads LOW while the board is off)\n• R13 holds MISO high between frames"
		(exclude_from_sim no)
		(at 27.94 173.99 0)
		(size 52.07 13.97)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "JetBrains Mono")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "98d89652-0ed1-428b-8c4d-d72750018015")
	)
	(text_box "DESIGN NOTE D2:\n• FPGA off or J3 unplugged: every EN and CLR low (PhotoMOS open, DAC cleared), CS and LDAC high\n• Bypass (JP1 closed, outputs float): R42 holds CLR low, R43 LDAC high, each R26 its EN low"
		(exclude_from_sim no)
		(at 27.94 156.21 0)
		(size 52.07 16.51)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
